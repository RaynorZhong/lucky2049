# Ignores Python bytecode cache directories.
# Ignores compiled Python files.
# Ignores optimized Python files.
__pycache__/
*.pyc 
*.pyo
*.egg-info

# Ignores virtual environment directories.
# Ignores environment variable files.
# Ignores database files.
.env
.venv/
*.db
*.db-journal
*.sqlite

# Large local seed CSV (~82MB) — local-only cold-start data, never commit.
data/*.csv

# Ignores test / coverage artifacts.
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Ignores log files.
*.log

# Ignores swap files.
*.swp
*.swo

# Ignores idea and vscode directories.
*.idea/
*.vscode/

# Ignores MacOS system files.
*.DS_Store

# Ignores output directories.
output/
# Generated static site (built by scripts/export_static.py, published to gh-pages).
site/
BACKUP.md
lucky.py
